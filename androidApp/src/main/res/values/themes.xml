<resources>
    <color name="deck_body">#FF0A59AD</color>
    <!-- Cobalt window so there is no flash before Compose draws the deck. -->
    <style name="Theme.Rewinder" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/deck_body</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
